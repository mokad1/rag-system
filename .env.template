# RAG Knowledge Base Q&A System — Environment Variables
# Copy to .env: cp .env.template .env

# ── LLM API (OpenAI-compatible) ────────────────────
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ── Embedding Model ────────────────────────────────
# bge-small-zh-v1.5 (384-dim), auto-download from HuggingFace
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu

# ── Reranker Model ─────────────────────────────────
# bge-reranker-base, auto-download from HuggingFace
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu

# ── Chunking Params ────────────────────────────────
PARENT_CHUNK_SIZE=800
CHILD_CHUNK_SIZE=300
CHUNK_OVERLAP=50
FIXED_CHUNK_SIZE=500

# ── Retrieval Params ───────────────────────────────
HYBRID_TOP_K=20
FINAL_TOP_K=5

# ── Memory ─────────────────────────────────────────
SHORT_TERM_WINDOW=3
MAX_MEMORY_TURNS=6

# ── Data Directory ─────────────────────────────────
DATA_DIR=./data

# ── Logging ────────────────────────────────────────
LOG_LEVEL=INFO
